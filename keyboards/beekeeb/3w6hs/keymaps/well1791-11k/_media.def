// ==============================================================
// Media module  —  included 3x by keymap.c (layer only)
// ==============================================================
// Contains : layer [_MEDIA]
// Needs    : QMK media keycodes, QK_BOOT
// Note     : kanata's me_si "systemctl restart kanata" chord is a
//            host command and cannot run from firmware; QK_BOOT
//            occupies both SI positions instead (user decision).
//            Bottom index/middle are KC_NO (kanata me_bi/me_bm XX).
//            Bottom-pinky QK_BOOTs are a QMK-only convenience
//            (kanata leaves those positions as pass-through letters).
// ==============================================================
#if defined(KMB_LAYER)
    [_MEDIA] = LAYOUT_split_3x5_3(
            KC_BRIU, KC_MPRV, KC_VOLU, KC_MUTE, _______, /*||*/ _______, KC_MUTE, KC_VOLU, KC_MPRV, KC_BRIU,
            KC_BRID, KC_MNXT, KC_VOLD, KC_MPLY, QK_BOOT, /*||*/ QK_BOOT, KC_MPLY, KC_VOLD, KC_MNXT, KC_BRID,
            _______, _______,   KC_NO,   KC_NO, _______, /*||*/ _______,   KC_NO,   KC_NO, _______, _______,
                              _______, _______, _______, /*||*/ _______, _______, _______
    ),
#endif
